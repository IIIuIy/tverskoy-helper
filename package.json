{
  "name": "tverskoy-helper",
  "productName": "Tverskoy Helper",
  "version": "0.1.0",
  "description": "Tverskoy Helper — игровой помощник для GTA V RP-проектов",
  "main": "out/main/index.js",
  "author": "Tverskoy Helper",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "ru.tverskoy.helper",
    "productName": "Tverskoy Helper",
    "directories": { "output": "release" },
    "files": ["out/**/*"],
    "extraResources": [{ "from": "config", "to": "config" }],
    "win": { "target": ["nsis", "portable"] }
  }
}
